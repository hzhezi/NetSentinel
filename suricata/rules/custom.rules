# NetSentinel 自定义 Suricata 规则集。
#
# ⚠️ 格式要求：**每条规则必须写成单行**。
#    多行（用 `(` 换行缩进）在 Suricata 7 下会解析失败，
#    报错 "Signature missing required value sid" —— 因为引擎按行解析。
#    这是实测踩过的坑。
#
# sid 从 1000001 起，避开官方规则集占用的号段。
# 字段说明见文末。
#
# 覆盖的攻击类型（对应设计文档 §5.2）：
#   SQL 注入 / 目录穿越 / XSS / Log4Shell / SSH 爆破 /
#   Nmap 扫描 / TCP SYN 扫描 / ICMP 扫描 / 反弹 shell / DNS 隧道

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"Possible SQL Injection (UNION SELECT)"; flow:established,to_server; content:"UNION"; http_uri; nocase; content:"SELECT"; http_uri; nocase; distance:0; classtype:web-application-attack; sid:1000001; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"Possible SQL Injection (OR 1=1)"; flow:established,to_server; content:"' OR 1=1"; http_uri; nocase; classtype:web-application-attack; sid:1000002; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"Directory Traversal Attempt (/etc/passwd)"; flow:established,to_server; content:"/etc/passwd"; http_uri; nocase; classtype:attempted-recon; sid:1000003; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"Possible XSS Attempt (script tag in URI)"; flow:established,to_server; content:"<script"; http_uri; nocase; classtype:web-application-attack; sid:1000004; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Log4Shell JNDI Injection Attempt (CVE-2021-44228)"; flow:established,to_server; content:"${jndi:"; nocase; classtype:attempted-admin; sid:1000005; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SSH_PORTS (msg:"SSH Brute Force Attempt"; flow:established,to_server; content:"SSH-"; depth:4; threshold:type limit, track by_src, count 5, seconds 60; classtype:attempted-login; sid:1000006; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Nmap OS Detection Probe (multiple TCP flags)"; flags:FPU; classtype:network-scan; sid:1000007; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"TCP Port Scan Detected"; flags:S; threshold:type both, track by_src, count 30, seconds 10; classtype:network-scan; sid:1000009; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ICMP Ping Sweep Detected"; itype:8; threshold:type both, track by_src, count 10, seconds 10; classtype:network-scan; sid:1000010; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Possible Reverse Shell (/bin/bash interactive)"; flow:established,to_server; content:"/bin/bash -i"; nocase; classtype:suspicious-login; sid:1000011; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"Suspicious Large DNS TXT Query (possible tunneling)"; dsize:>200; classtype:bad-unknown; sid:1000012; rev:1;)

# ── 字段说明（便于后续扩充）────────────────────────────────────
#   msg        告警签名，最终显示在平台上
#   flow       会话方向（to_server = 客户端→服务端）
#   content    载荷特征串；配合 http_uri 等修饰符限定位置
#   threshold  同源计数，用于"短时间内多次"这类行为检测
#              （这正是单条流特征做不到、而规则引擎擅长的地方）
#   flags      TCP 标志位匹配（多标志同时置位是扫描的典型特征）
#   classtype  分类，影响平台的 category 字段
#   sid        规则唯一编号；rev 为修订号
