# Suricata 检测引擎镜像。
#
# 用 Alpine 包管理器装 Suricata，而非从源码编译 —— 快且够用。
# 本镜像的用途是**离线读取 pcap**（suricata -r），不需要抓包能力，
# 因此运行时不需要特权或 NET_RAW（与在线 IDS 部署不同）。
FROM alpine:3.20

RUN apk add --no-cache suricata tzdata && \
    mkdir -p /var/log/suricata /data

# 规则放到 /etc/suricata/rules/
COPY suricata/rules/ /etc/suricata/rules/

# 用项目自带配置覆盖默认配置。
#
# 注意：这份配置是**精简版**（apk 的默认配置本身也很精简）。
# 关键要求写在 suricata.yaml 顶部的注释里：
#   - HTTP_SERVERS 必须放在 address-groups（填网段），放 port-groups 会报错
#   - 变量间引用（如 !$HOME_NET）在部分版本下解析失败，直接写明网段更稳
#   - 规则必须单行，多行会导致 "Signature missing required value sid"
COPY suricata/suricata.yaml /etc/suricata/suricata.yaml

WORKDIR /data

# 默认行为：打印版本（实际运行由 docker run 覆盖命令传入 pcap 路径）
CMD ["suricata", "--version"]
