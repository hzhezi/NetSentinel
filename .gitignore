# ── Secrets / environment ──────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
